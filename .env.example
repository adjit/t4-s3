# Copy to .env and adjust. docker compose reads .env from the repo root; `pnpm dev` does not,
# so export these in your shell (or use a tool like direnv) when running without Docker.

# --- App ---------------------------------------------------------------------
# Login token for the web UI and API (Authorization: Bearer <token>).
# "local-dev-token" is a DEV DEFAULT. Pick a long random value for anything beyond your own machine.
# If unset outside Docker, the API generates one and writes it to <data dir>/dev-token.txt.
T4_TOKEN=local-dev-token
# Name recorded in the audit log for actions from this instance.
T4_ACTOR=local
# Host port for docker compose (container port is always 8080).
T4_PORT=8080

# --- Running without Docker (pnpm dev / pnpm start) ------------------------------
# Data dir for the DuckDB index and stored connection secrets. Default: <repo>/data
# T4_DATA_DIR=./data
# PORT=8080
# HOST=0.0.0.0
# T4_DUCKDB_MEMORY=2GB
# T4_DUCKDB_THREADS=4
# Serve a built web UI from the API, as an absolute path (the Docker image sets this):
# T4_WEB_DIST=/path/to/t4-storage/apps/web/dist

# --- Optional: pre-configure one store at startup ------------------------------
# Off unless BOTH T4_S3_ENDPOINT and T4_S3_BUCKET are set. On every start the API then
# creates/updates a connection named T4_S3_NAME and registers T4_S3_BUCKET (not indexed).
# Most people should add stores in the UI instead.
# T4_S3_NAME=minio
# T4_S3_ENDPOINT=http://localhost:9000
# T4_S3_BUCKET=demo
# T4_S3_ACCESS_KEY_ID=
# T4_S3_SECRET_ACCESS_KEY=
# T4_S3_REGION=us-east-1
# T4_S3_URL_STYLE=path
# T4_S3_USE_SSL=false
# T4_S3_TLS_VERIFY=true
# T4_S3_CA_BUNDLE=
# T4_S3_PROVIDER=minio
# T4_S3_RATE=

# --- Optional local MinIO (docker-compose.minio.yml) ----------------------------
# T4_MINIO_PORT=9000
# T4_MINIO_CONSOLE_PORT=9001
